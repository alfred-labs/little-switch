{
  "$ref": "#/definitions/OpenAIChatChunk",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ChatCompletionChunk": {
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/definitions/ChatCompletionChunk.Choice"
          },
          "type": "array"
        },
        "created": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "moderation": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChatCompletionChunk.Moderation"
            },
            {
              "type": "null"
            }
          ]
        },
        "obfuscation": {
          "type": "string"
        },
        "object": {
          "const": "chat.completion.chunk",
          "type": "string"
        },
        "service_tier": {
          "enum": [
            "auto",
            "default",
            "flex",
            "scale",
            "priority",
            "fast",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "system_fingerprint": {
          "deprecated": "This fingerprint represents the backend configuration that the model\nruns with. Can be used in conjunction with the `seed` request parameter to\nunderstand when backend changes have been made that might impact determinism.",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/CompletionUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "choices",
        "created",
        "model",
        "object"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Choice": {
      "properties": {
        "delta": {
          "$ref": "#/definitions/ChatCompletionChunk.Choice.Delta"
        },
        "finish_reason": {
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "content_filter",
            "function_call",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "type": "number"
        },
        "logprobs": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChatCompletionChunk.Choice.Logprobs"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "delta",
        "finish_reason",
        "index"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Delta": {
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "function_call": {
          "$ref": "#/definitions/ChatCompletionChunk.Choice.Delta.FunctionCall",
          "deprecated": "Deprecated and replaced by `tool_calls`. The name and arguments of a\nfunction that should be called, as generated by the model."
        },
        "refusal": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "developer",
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/definitions/ChatCompletionChunk.Choice.Delta.ToolCall"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Delta.FunctionCall": {
      "deprecated": "Deprecated and replaced by `tool_calls`. The name and arguments of a\nfunction that should be called, as generated by the model.",
      "properties": {
        "arguments": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Delta.ToolCall": {
      "properties": {
        "custom": {
          "$ref": "#/definitions/ChatCompletionChunk.Choice.Delta.ToolCall.Custom"
        },
        "function": {
          "$ref": "#/definitions/ChatCompletionChunk.Choice.Delta.ToolCall.Function"
        },
        "id": {
          "type": "string"
        },
        "index": {
          "type": "number"
        },
        "type": {
          "enum": [
            "function",
            "custom"
          ],
          "type": "string"
        }
      },
      "required": [
        "index"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Delta.ToolCall.Custom": {
      "properties": {
        "input": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Delta.ToolCall.Function": {
      "properties": {
        "arguments": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ChatCompletionChunk.Choice.Logprobs": {
      "properties": {
        "content": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/ChatCompletionTokenLogprob"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/ChatCompletionTokenLogprob"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "content",
        "refusal"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Moderation": {
      "properties": {
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChatCompletionChunk.Moderation.ModerationResults"
            },
            {
              "$ref": "#/definitions/ChatCompletionChunk.Moderation.Error"
            }
          ]
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChatCompletionChunk.Moderation.ModerationResults"
            },
            {
              "$ref": "#/definitions/ChatCompletionChunk.Moderation.Error"
            }
          ]
        }
      },
      "required": [
        "input",
        "output"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Moderation.Error": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "const": "error",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "type"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Moderation.ModerationResults": {
      "properties": {
        "model": {
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/definitions/ChatCompletionChunk.Moderation.ModerationResults.Result"
          },
          "type": "array"
        },
        "type": {
          "const": "moderation_results",
          "type": "string"
        }
      },
      "required": [
        "model",
        "results",
        "type"
      ],
      "type": "object"
    },
    "ChatCompletionChunk.Moderation.ModerationResults.Result": {
      "properties": {
        "categories": {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        "category_applied_input_types": {
          "additionalProperties": {
            "items": {
              "enum": [
                "text",
                "image"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "category_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "flagged": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "type": {
          "const": "moderation_result",
          "type": "string"
        }
      },
      "required": [
        "categories",
        "category_applied_input_types",
        "category_scores",
        "flagged",
        "model",
        "type"
      ],
      "type": "object"
    },
    "ChatCompletionTokenLogprob": {
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "logprob": {
          "type": "number"
        },
        "token": {
          "type": "string"
        },
        "top_logprobs": {
          "items": {
            "$ref": "#/definitions/ChatCompletionTokenLogprob.TopLogprob"
          },
          "type": "array"
        }
      },
      "required": [
        "token",
        "bytes",
        "logprob",
        "top_logprobs"
      ],
      "type": "object"
    },
    "ChatCompletionTokenLogprob.TopLogprob": {
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "logprob": {
          "type": "number"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token",
        "bytes",
        "logprob"
      ],
      "type": "object"
    },
    "CompletionUsage": {
      "properties": {
        "completion_tokens": {
          "type": "number"
        },
        "completion_tokens_details": {
          "$ref": "#/definitions/CompletionUsage.CompletionTokensDetails"
        },
        "prompt_tokens": {
          "type": "number"
        },
        "prompt_tokens_details": {
          "$ref": "#/definitions/CompletionUsage.PromptTokensDetails"
        },
        "total_tokens": {
          "type": "number"
        }
      },
      "required": [
        "completion_tokens",
        "prompt_tokens",
        "total_tokens"
      ],
      "type": "object"
    },
    "CompletionUsage.CompletionTokensDetails": {
      "properties": {
        "accepted_prediction_tokens": {
          "type": "number"
        },
        "audio_tokens": {
          "type": "number"
        },
        "reasoning_tokens": {
          "type": "number"
        },
        "rejected_prediction_tokens": {
          "type": "number"
        },
        "text_tokens": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "CompletionUsage.PromptTokensDetails": {
      "properties": {
        "audio_tokens": {
          "type": "number"
        },
        "cache_write_tokens": {
          "type": "number"
        },
        "cached_tokens": {
          "type": "number"
        },
        "image_tokens": {
          "type": "number"
        },
        "text_tokens": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "OpenAIChatChunk": {
      "$ref": "#/definitions/ChatCompletionChunk"
    }
  }
}
